# Copy to .env. Anything starting with EXPO_PUBLIC_ is bundled into the app: never put secrets here.
EXPO_PUBLIC_API_URL=https://chiegotrading.com/api/v1
# Google OAuth client IDs (Google Cloud console). Leave empty to hide "Continue with Google".
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# EAS project id (npx eas-cli init) - needed for push notifications
EXPO_PUBLIC_EAS_PROJECT_ID=
